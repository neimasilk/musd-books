,\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalAnchors\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"anchor(bytes32,address,address,uint64,uint64,string)\":{\"params\":{\"statementHash\":\"keccak256 of the canonical statement CSV bytes.\"}}},\"stateVariables\":{\"_anchors\":{\"details\":\"statement hash => anchors (several parties may attest the same statement)\"},\"_statementsByAccount\":{\"details\":\"account => statement hashes anchored for it, in anchoring order\"},\"attested\":{\"details\":\"statement hash => attester => already attested\"}},\"title\":\"StatementRegistry\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"anchor(bytes32,address,address,uint64,uint64,string)\":{\"notice\":\"Anchor a statement hash for `account` and `token` covering blocks [fromBlock, toBlock].\"},\"anchorCount(bytes32)\":{\"notice\":\"Number of anchors recorded for a statement hash.\"},\"getAnchors(bytes32)\":{\"notice\":\"All anchors recorded for a statement hash.\"},\"statementsOf(address,uint256,uint256)\":{\"notice\":\"Paginated list of statement hashes anchored for an account.\"}},\"notice\":\"Lets anyone anchor the hash of a token account statement (MUSD, MEZO or any         ERC-20) generated by MUSD Books for an address over a block range. Because the         statements are derived deterministically from onchain data, an accountant,         lender or tax consultant can regenerate the statement, hash it, and check it         against the anchor. Anchors live in contract storage, so verification is a single         view call with no log scanning.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/StatementRegistry.sol\":\"StatementRegistry\"},\"evmVersion\":\"london\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\"