;;;5030:1;5027;5020:12;4982:52;5062:9;5056:16;5115:5;5108:13;5101:21;5094:5;5091:32;5081:60;;5137:1;5134;5127:12;5081:60;5160:5;4894:277;-1:-1:-1;;;4894:277:23:o","linkReferences":{}},"methodIdentifiers":{"MAX_REF_BYTES()":"7c21a74e","pay(address,address,uint256,string)":"84a60232","payWithPermit(address,address,uint256,string,uint256,uint8,bytes32,bytes32)":"fa638b04"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"name\":\"RefTooLong\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"TokenNotContract\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"TransferFailed\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ZeroAmount\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ZeroMerchant\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"payer\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"merchant\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"bytes32\",\"name\":\"refHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"string\",\"name\":\"ref\",\"type\":\"string\"}],\"name\":\"PaymentReference\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"MAX_REF_BYTES\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"merchant\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"ref\",\"type\":\"string\"}],\"name\":\"pay\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"merchant\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"ref\",\"type\":\"string\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"uint8\",\"name\":\"v\",\"type\":\"uint8\"},{\"internalType\":\"bytes32\",\"name\":\"r\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"s\",\"type\":\"bytes32\"}],\"name\":\"payWithPermit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"MusdPay\",\"version\":1},\"userdoc\":{\"events\":{\"PaymentReference(address,address,address,uint256,bytes32,string)\":{\"notice\":\"Emitted directly after the token's `Transfer` log for the same payment.\"}},\"kind\":\"user\",\"methods\":{\"pay(address,address,uint256,string)\":{\"notice\":\"Pay `amount` of `token` to `merchant` with a reference. The payer must have         approved this contract for at least `amount` first.\"},\"payWithPermit(address,address,uint256,string,uint256,uint8,bytes32,bytes32)\":{\"notice\":\"Same as `pay`, but the approval is granted by an EIP-2612 permit signature, so         the payer needs a single transaction. If the permit was already used (for         example by someone relaying the signature first) the payment still goes through         as long as the allowance is sufficient.\"}},\"notice\":\"Pays an ERC-20 (MUSD by default, MEZO or any other token also works) from the         caller to a merchant and attaches an invoice or order reference to the payment.         Mezo has no memo precompile, so a plain `transfer` carries no reference. MusdPay         moves the tokens with `transferFrom` and emits `PaymentReference` as the log         immediately after the token's own `Transfer` log. A MUSD Books statement joins the         two by position, so every incoming payment reconciles to its invoice exactly.         The contract holds no funds, has no owner, no fee and no upgrade path: tokens go         straight from payer to merchant inside one call.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/MusdPay.sol\":\"MusdPay\"},\"evmVersion\":\"london\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/MusdPay.sol\":{\"keccak256\":\"0x9a997f13ccea9973a085f3895e8130e1206ac4ec21cca50031337cf953ffe061\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://68233228697a1574f9883d98ab70dc9404620efa47cb5f969ac6a5a1cb961e62\",\"dweb:/ipfs/QmYMR4VUmbGpEXZd5K4KyS3yKzcsByK5o6PZBAd4aoM65z\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.30+commit.73712a01"},"language":"Solidity","output":{"abi":[{"inputs":[],"type":"error","name":"RefTooLong"},{"inputs":[],"type":"error","name":"TokenNotContract"},{"inputs":[],"type":"error","name":"TransferFailed"},{"inputs":[],"type":"error","name":"ZeroAmount"},{"inputs":[],"type":"error","name":"ZeroMerchant"},{"inputs":[{"internalType":"address","name":"token","type":"address","indexed":true},{"internalType":"address","name":"payer","type":"address","indexed":true},{"internalType":"address","name":"merchant","type":"address","indexed":true},{"internalType":"uint256","name":"amount","type":"uint256","indexed":false},{"internalType":"bytes32","name":"refHash","type":"bytes32","indexed":false},{"internalType":"string","name":"ref","type":"string","indexed":false}],"type":"event","name":"PaymentReference","anonymous":false},{"inputs":[],"stateMutability":"view","type":"function","name":"MAX_REF_BYTES","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"address","name":"merchant","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"string","name":"ref","type":"string"}],"stateMutability":"nonpayable","type":"function","name":"pay"},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"address","name":"merchant","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"string","name":"ref","type":"string"},{"internalType":"uint256","name":"deadline","type":"uint256"},{"internalType":"uint8","name":"v","type":"uint8"},{"internalType":"bytes32","name":"r","type":"bytes32"},{"internalType":"bytes32","name":"s","type":"bytes32"}],"stateMutability":"nonpayable","type":"function","name":"payWithPermit"}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{"pay(address,address,uint256,string)":{"notice":"Pay `amount` of `token` to `merchant` with a reference. The payer must have         approved this contract for at least `amount` first."},"payWithPermit(address,address,uint256,string,uint256,uint8,bytes32,bytes32)":{"notice":"Same as `pay`, but the approval is granted by an EIP-2612 permit signature, so         the payer needs a single transaction. If the permit was already used (for         example by someone relaying the signature first) the payment still goes through         as long as the allowance is sufficient."}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/MusdPay.sol":"MusdPay"},"evmVersion":"london","libraries":{}},"sources":{"src/MusdPay.sol":{"keccak256":"0x9a997f13ccea9973a085f3895e8130e1206ac4ec21cca50031337cf953ffe061","urls":["bzz-raw://68233228697a1574f9883d98ab70dc9404620efa47cb5f969ac6a5a1cb961e62","dweb:/ipfs/QmYMR4VUmbGpEXZd5K4KyS3yKzcsByK5o6PZBAd4aoM65z"],"license":"MIT"}},"version":1},"id":19}